{
  "name": "chess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "test:profile": "node scripts/profile-tests.cjs",
    "test:i18n": "node scripts/i18n-tests.cjs",
    "test:sound": "node scripts/sound-tests.cjs",
    "test:release-smoke": "node scripts/release-smoke-tests.cjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "npm run test:i18n && npm run test:profile && npm run test:sound && npm run test:unit",
    "validate": "npm run typecheck && npm run lint && npm run test && vite build && npm run test:release-smoke",
    "validate:ci": "npm run validate",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
