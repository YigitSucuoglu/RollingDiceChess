# Public browser configuration. The DSN identifies a Sentry project but is not a secret.
VITE_SENTRY_DSN=
# Optional public deployment label, for example preview or production.
VITE_DEPLOY_ENV=

# Build-only secrets/identifiers for source-map upload. Never prefix the token with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
