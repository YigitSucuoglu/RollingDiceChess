# Public browser configuration. The DSN identifies a Sentry project but is not a secret.
VITE_SENTRY_DSN=
# Optional public deployment label, for example preview or production.
VITE_DEPLOY_ENV=
# Temporary OBS-01B build flag. Enable only for a controlled verification deploy.
VITE_OBSERVABILITY_TEST_MODE=

# Public Supabase browser configuration. Never use a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Vite-development-only trusted multiplayer API origin. It is consumed by the
# Vite server, never exposed to browser code, and defaults to the production Vercel origin.
MULTIPLAYER_API_PROXY_TARGET=

# Build-only secrets/identifiers for source-map upload. Never prefix the token with VITE_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
